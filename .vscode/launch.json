{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Streamlit: Inventory Entry",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/Inventory.py",
                "--server.headless",
                "false"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Streamlit: Run Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${file}",
                "--server.headless",
                "false"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
